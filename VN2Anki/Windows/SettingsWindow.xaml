<Window x:Class="VN2Anki.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VN2Anki"
        xmlns:loc="clr-namespace:VN2Anki.Locales"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        Title="{x:Static loc:Strings.LblSettingsWindow}" Height="625" Width="575"
        Background="#252526" Foreground="White" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:StatusConverter x:Key="StatusConverter" />
            <local:StatusColorConverter x:Key="StatusColorConverter" />
            <local:HotkeyConverter x:Key="HotkeyConverter" />

            <Style x:Key="StandardTextBlock" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#EAEAEA"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style x:Key="StandardComboBox" TargetType="ComboBox">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="5"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StandardButton" TargetType="Button">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Background" Value="#3F3F46"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                        <Setter Property="Background" Value="#222222"/>
                        <Setter Property="Foreground" Value="#888888"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
                <Setter Property="Background" Value="#28A745"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,20,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0" Grid.Row="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#EAEAEA"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="TabBorder" 
                                        Background="{TemplateBinding Background}" 
                                        BorderThickness="0" 
                                        CornerRadius="4,4,0,0" 
                                        Padding="{TemplateBinding Padding}" 
                                        Margin="{TemplateBinding Margin}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      ContentSource="Header"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4d4d53"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="#007ACC"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabItem Header="{x:Static loc:Strings.HeaderConfig}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblAudioSource}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboAudio" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AudioDevices}" DisplayMemberPath="DisplayName" SelectedValuePath="Name" SelectedValue="{Binding Config.Media.AudioDevice}" IsEnabled="{Binding IsAudioSelectionEnabled}"/>
                        <Button Style="{StaticResource StandardButton}" Grid.Row="0" Grid.Column="2" Width="35" Height="35" Click="BtnRefreshAudio_Click" Padding="0" IsEnabled="{Binding IsAudioSelectionEnabled}">
                            <TextBlock Text="🔄" FontSize="18"/>
                        </Button>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblVideoSource}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboVideo" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VideoWindows}" DisplayMemberPath="DisplayName" SelectedValuePath="ProcessName" SelectedValue="{Binding Config.Media.VideoWindow}" IsEnabled="{Binding IsVideoSelectionEnabled}"/>
                        <Button Style="{StaticResource StandardButton}" Grid.Row="1" Grid.Column="2" Width="35" Height="35" Click="BtnRefreshVideo_Click" Padding="0" IsEnabled="{Binding IsVideoSelectionEnabled}">
                            <TextBlock Text="🔄" FontSize="18"/>
                        </Button>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblSlotLimit}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="TxtMaxSlots" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Padding="5" Text="{Binding Config.Session.MaxSlots, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblAudioQuality}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboAudioRes" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" SelectedValue="{Binding Config.Media.AudioBitrate}">
                            <ComboBoxItem Content="MP3 192 kbps (HQ)" Tag="192"/>
                            <ComboBoxItem Content="MP3 128 kbps (Default)" Tag="128"/>
                            <ComboBoxItem Content="MP3 96 kbps (Small)" Tag="96"/>
                            <ComboBoxItem Content="MP3 64 kbps (Tiny)" Tag="64"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblImageQuality}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboImageRes" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" SelectedValue="{Binding Config.Media.MaxImageWidth}">
                            <ComboBoxItem Content="Original" Tag="0"/>
                            <ComboBoxItem Content="1280px (720p/HQ)" Tag="1280"/>
                            <ComboBoxItem Content="720px (Standard)" Tag="720"/>
                            <ComboBoxItem Content="640px (Small)" Tag="640"/>
                            <ComboBoxItem Content="480px (Tiny)" Tag="480"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblLanguage}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboLanguage" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="ComboLanguage_SelectionChanged" SelectedValuePath="Tag" SelectedValue="{Binding Config.General.Language}">
                            <ComboBoxItem Content="English" Tag="en-US"/>
                            <ComboBoxItem Content="Español" Tag="es-ES"/>
                            <ComboBoxItem Content="Português" Tag="pt-BR"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkOpenSettings" Content="{x:Static loc:Strings.LblOpenSettingsOnStartup}" Foreground="White" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,15,5,5" VerticalAlignment="Center" IsChecked="{Binding Config.General.OpenSettingsOnStartup}"/>
                        <CheckBox x:Name="ChkSilentSync" Content="{x:Static loc:Strings.LblSilentSync}" Foreground="White" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,5,0" VerticalAlignment="Center" IsChecked="{Binding Config.Session.SilentSync}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static loc:Strings.TabHook}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblAutoLaunchHooker}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Grid.Row="0" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Config.Hook.AutoLaunchHooker}">
                            <ComboBoxItem Content="{x:Static loc:Strings.LblNone}" Tag="None"/>
                            <ComboBoxItem Content="Textractor" Tag="Textractor"/>
                            <ComboBoxItem Content="LunaTranslator" Tag="LunaTranslator"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblTextractorPath}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Hook.TextractorBasePath}" ToolTip="Folder containing x86 and x64 subfolders"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblLunaPath}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Hook.LunaTranslatorPath}" ToolTip="Direct path to LunaTranslator.exe"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblHookSource}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboHookType" Grid.Row="3" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Config.Hook.ActiveHookType}" SelectionChanged="ComboHookType_SelectionChanged">
                            <ComboBoxItem Content="{x:Static loc:Strings.LblClipboard}" Tag="0"/>
                            <ComboBoxItem Content="{x:Static loc:Strings.LblWsLuna}" Tag="1"/>
                            <ComboBoxItem Content="{x:Static loc:Strings.LblWsTextractor}" Tag="2"/>
                            <ComboBoxItem Content="MPV (IPC)" Tag="3"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource StandardTextBlock}" x:Name="LblWsUrl" Text="{x:Static loc:Strings.LblWsUrl}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="TxtWsUrl" Grid.Row="4" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Hook.WebSocketUrl}" ToolTip="Luna: ws://localhost:2333/api/ws/text/origin | Textractor: ws://localhost:6677"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" x:Name="LblMpvPipe" Text="MPV Pipe Name" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal" Visibility="Collapsed"/>
                        <TextBox x:Name="TxtMpvPipe" Grid.Row="5" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Hook.MpvPipeName}" Visibility="Collapsed" ToolTip="Default: mpv-ipc. Start mpv with --input-ipc-server=mpv-ipc"/>

                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical" Margin="5,15,5,5">
                            <CheckBox x:Name="ChkFilterSimilar" 
                                      Content="{x:Static loc:Strings.LblFilterSimilar}" 
                                      IsChecked="{Binding Config.Session.FilterSimilarPhrases}" 
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" 
                                        Visibility="{Binding IsChecked, ElementName=ChkFilterSimilar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{x:Static loc:Strings.LblSimilarityThreshold}" Foreground="#EAEAEA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Minimum="0.5" Maximum="1.0" Width="100" 
                                        Value="{Binding Config.Session.SimilarityThreshold}" 
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding Config.Session.SimilarityThreshold, StringFormat={}{0:P0}}" 
                                           Foreground="#EAEAEA" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static loc:Strings.HeaderAnki}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblDeck}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboDeck" Grid.Row="0" Grid.Column="1" SelectedValue="{Binding Config.Anki.Deck}"/>
                        <Button Style="{StaticResource StandardButton}" Grid.Row="0" Grid.Column="2" Width="35" Height="35" Padding="0" Click="BtnRefreshAnki_Click">
                            <TextBlock Text="🔄" FontSize="18"/>
                        </Button>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblNoteType}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboModel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="ComboModel_SelectionChanged" SelectedValue="{Binding Config.Anki.Model}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblAudioField}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboFieldAudio" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedValue="{Binding Config.Anki.AudioField}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblImageField}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" x:Name="ComboFieldImage" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedValue="{Binding Config.Anki.ImageField}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblAnkiUrl}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="TxtAnkiUrl" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Padding="5" Text="{Binding Config.Anki.Url, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblTimeout}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="TxtAnkiTimeout" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Padding="5" Text="{Binding Config.Anki.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Yomitan Bridge Settings -->
                        <Border Grid.Row="6" Grid.ColumnSpan="3" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,15,0,10" />

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblYomitanBridgePort}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox x:Name="TxtYomitanBridgePort" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Padding="5" Text="{Binding Config.Anki.YomitanBridgePort, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static loc:Strings.TabOverlay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,15,0,0" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblOverlayBg}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <colorpicker:PortableColorPicker x:Name="PickerBgColor" Style="{StaticResource DefaultColorPickerStyle}" Grid.Row="0" Grid.Column="1" Margin="5" HorizontalAlignment="Left" Width="60" Height="30" />

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblOverlayFontColor}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <colorpicker:PortableColorPicker x:Name="PickerFontColor" Style="{StaticResource DefaultColorPickerStyle}" Grid.Row="1" Grid.Column="1" Margin="5" HorizontalAlignment="Left" Width="60" Height="30" />

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblOverlayOutlineColor}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <colorpicker:PortableColorPicker x:Name="PickerOutlineColor" Style="{StaticResource DefaultColorPickerStyle}" HorizontalAlignment="Left" Width="60" Height="30" Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static loc:Strings.LblThickness}" VerticalAlignment="Center" Foreground="#EAEAEA" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding Config.Overlay.OutlineThickness, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="5" TextAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblOverlayFontFamily}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Overlay.FontFamily, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex: Meiryo, MS Gothic, Yu Gothic, Segoe UI"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblOverlayFontSize}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Overlay.FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="{x:Static loc:Strings.LblUseTextBoxMode}" Grid.Row="5" Grid.Column="1" Margin="5,15,5,5" IsChecked="{Binding Config.Overlay.UseTextBoxMode}" Foreground="White" FontWeight="SemiBold"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblBoxMinHeight}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Overlay.TextBoxMinHeight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Config.Overlay.UseTextBoxMode}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblBoxWidth}" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="5" Padding="5" Text="{Binding Config.Overlay.TextBoxWidthPercentage, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblDisplacementMargins}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{x:Static loc:Strings.LblHorizX}" VerticalAlignment="Center" Foreground="#EAEAEA" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding Config.Overlay.HorizontalDisplacement, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="5" TextAlignment="Center" Margin="0,0,10,0" ToolTip="Positivo = Direita, Negativo = Esquerda"/>
                            <TextBlock Text="{x:Static loc:Strings.LblVertY}" VerticalAlignment="Center" Foreground="#EAEAEA" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding Config.Overlay.VerticalMargin, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="5" TextAlignment="Center" ToolTip="Margem em relação ao Topo ou Fundo"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource StandardTextBlock}" Text="{x:Static loc:Strings.LblTextVerticalAlign}" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Grid.Row="9" Grid.Column="1" Margin="5" Padding="5" SelectedValuePath="Tag" SelectedValue="{Binding Config.Overlay.TextVerticalAlignment}">
                            <ComboBoxItem Content="{x:Static loc:Strings.LblTop}" Tag="flex-start"/>
                            <ComboBoxItem Content="{x:Static loc:Strings.LblCenter}" Tag="center"/>
                            <ComboBoxItem Content="{x:Static loc:Strings.LblBottom}" Tag="flex-end"/>
                        </ComboBox>

                        <Border Grid.Row="10" Grid.ColumnSpan="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,15,0,15" />

                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.TabHotkeys}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="{x:Static loc:Strings.LblHotkeyHint}" Foreground="#AAAAAA" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Config.Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{Binding ActionName}" Foreground="#EAEAEA" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    
                                    <TextBox Grid.Column="1" 
                                             Margin="10,0" 
                                             Padding="5" 
                                             Text="{Binding Converter={StaticResource HotkeyConverter}, Mode=OneWay}" 
                                             IsReadOnly="True" 
                                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                             Background="#333" 
                                             Foreground="White" 
                                             BorderThickness="1" 
                                             BorderBrush="#555"
                                             HorizontalContentAlignment="Center"/>
                                             
                                    <ToggleButton Grid.Column="2" 
                                                  Content="{Binding IsEnabled, Converter={StaticResource StatusConverter}}"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Padding="10,2"
                                                  Width="80"
                                                  Background="{Binding IsEnabled, Converter={StaticResource StatusColorConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static loc:Strings.TabExtensions}" x:Name="TabExtensions">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{x:Static loc:Strings.LblBrowser}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EAEAEA"/>
                        <ComboBox x:Name="ComboBrowser" Width="150" SelectionChanged="ComboBrowser_SelectionChanged">
                            <ComboBoxItem Content="Chrome" Tag="Chrome"/>
                            <ComboBoxItem Content="Edge" Tag="Edge"/>
                            <ComboBoxItem Content="Firefox" Tag="Firefox"/>
                            <ComboBoxItem Content="Brave" Tag="Brave"/>
                            <ComboBoxItem Content="Custom" Tag="Custom"/>
                        </ComboBox>
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="GridCustomPath" Visibility="Collapsed" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Strings.LblPath}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#EAEAEA"/>
                        <TextBox x:Name="TxtCustomPath" Grid.Column="1" Padding="5" Background="#333" Foreground="White" BorderThickness="1" BorderBrush="#555"/>
                        <Button Grid.Column="2" Content="..." Width="30" Margin="5,0,0,0" Click="BtnBrowse_Click" Background="#3F3F46" Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <ListView x:Name="ListExtensions" Grid.Row="2" Background="#1E1E1E" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:Strings.HeaderIcon}" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static loc:Strings.HeaderName}" DisplayMemberBinding="{Binding Name}" Width="250"/>
                                <GridViewColumn Header="{x:Static loc:Strings.HeaderSettings}" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⚙️" 
                                                    Click="BtnExtensionSettings_Click"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="Transparent" BorderThickness="0" Foreground="White"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static loc:Strings.HeaderStatus}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding IsEnabled, Converter={StaticResource StatusConverter}}" 
                                                          IsChecked="{Binding IsEnabled}"
                                                          Click="ToggleExtensionStatus_Click"
                                                          Padding="10,2"
                                                          Background="{Binding IsEnabled, Converter={StaticResource StatusColorConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{x:Static loc:Strings.BtnApplySettings}" Style="{StaticResource StandardButton}" Height="40" FontSize="14" Margin="0,0,10,0" Padding="15,0" Click="BtnApply_Click" Background="#007ACC"/>
            <Button Content="{x:Static loc:Strings.BtnSaveClose}" Style="{StaticResource SaveButton}" Margin="0" Padding="15,0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>