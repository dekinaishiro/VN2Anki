<UserControl x:Class="VN2Anki.Views.Hub.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VN2Anki.Converters"
             xmlns:views="clr-namespace:VN2Anki.Views.Hub"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImgPathConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de ferramentas superior: Ordenação -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,15">
            <TextBlock Text="Sort by:" VerticalAlignment="Center" Foreground="#888888" Margin="0,0,8,0" FontSize="12"/>
            
            <ComboBox Width="130" Height="28" 
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SortBy}"
                      Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3E3E42">
                <ComboBoxItem Content="Last Played" Tag="LastPlayed"/>
            </ComboBox>

            <Button Command="{Binding ToggleSortDirectionCommand}" 
                    Width="32" Height="28" Margin="5,0,0,0"
                    Background="#2D2D30" BorderThickness="1" BorderBrush="#3E3E42" Cursor="Hand" ToolTip="Toggle Order">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <iconPacks:PackIconMaterial x:Name="SortIcon" Kind="SortDescending" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAscending}" Value="True">
                                <Setter TargetName="SortIcon" Property="Kind" Value="SortAscending"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding VisualNovels}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D30" CornerRadius="8" Margin="10" Width="200" ClipToBounds="True" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.GoToDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Border.InputBindings>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="220"/> <!-- Restaurado para altura original -->
                                <RowDefinition Height="Auto"/> <!-- Info -->
                            </Grid.RowDefinitions>

                            <!-- Parte Superior: Cover e Botão Play -->
                            <Grid Grid.Row="0">
                                <Image Source="{Binding CoverImagePath, Converter={StaticResource ImgPathConverter}}" 
                                       Stretch="UniformToFill" />
                                
                                <!-- Botão Play: Redondo, Fundo Azul, Ícone Branco Centralizado -->
                                <Button Command="{Binding DataContext.PlayVnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                        Width="36" Height="36" Background="#28A745" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                <!-- Ícone centralizado: O triângulo precisa de uma leve margem esquerda para compensar visualmente o peso da base -->
                                                <Path Data="M 0,0 L 0,14 L 11,7 Z" 
                                                      Fill="White" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Margin="3,0,0,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Parte Inferior: Título, Play Time e Chars -->
                            <StackPanel Grid.Row="1" Margin="12,10">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14" 
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,0,0,6"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TEMPO" FontSize="9" Foreground="#888888" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FormattedTotalTime}" Foreground="#CCCCCC" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CHARS" FontSize="9" Foreground="#888888" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalCharactersRead}" Foreground="#28A745" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
